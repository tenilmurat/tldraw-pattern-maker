  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.1.0"
  }
